{
  "name": "commit-bloom-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "wrangler dev --local --test-scheduled",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "npm run typecheck && npm run build && node --test test/*.test.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler deploy",
    "secret:github": "node scripts/configure-github-secret.mjs",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261011.1",
    "miniflare": "5.20261006.1-alpha",
    "typescript": "5.9.3",
    "wrangler": "4.149.0"
  }
}
