{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "botanical-garden",
  "account_id": "5a0d2233cbfbbe959567a9c5ee9ba876",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": { "REFRESH_BATCH_SIZE": "4" },
  // Poll for due gardens; each garden is regenerated once per day after 00:20 UTC.
  "triggers": { "crons": ["*/10 * * * *"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "botanical-garden",
    "database_id": "a4145975-946b-47d0-b7d5-e68216289464",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "GARDENS", "bucket_name": "botanical-gardens" }]
}
